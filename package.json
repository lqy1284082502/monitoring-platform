{
    "name": "monitoring-platform",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "generate:previews": "node scripts/generate-previews.mjs",
        "build": "tsc && vite build --mode production",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
        "clean:lib": "rimraf node_modules",
        "lint:prettier": "prettier --write .prettierrc.cjs package.json \"src/**/*.{js,ts,tsx,json,css,less,scss,vue,html,md}\"",
        "lint:prettier:check": "prettier --check .prettierrc.cjs package.json \"src/**/*.{js,ts,tsx,json,css,less,scss,vue,html,md}\"",
        "lint:style": "stylelint src/**/*.{css,scss,less} --cache --fix"
    },
    "dependencies": {
        "@monogrid/gainmap-js": "^3.0.1",
        "@tweenjs/tween.js": "^20.0.3",
        "@types/three": "^0.159.0",
        "d3": "^7.8.5",
        "gsap": "^3.12.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.20.0",
        "three": "^0.159.0",
        "typescript": "^5.1.6"
    },
    "devDependencies": {
        "@types/d3": "^7.4.3",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@typescript-eslint/eslint-plugin": "^5.57.1",
        "@typescript-eslint/parser": "^5.57.1",
        "@vitejs/plugin-react": "^4.0.0",
        "eslint": "^8.38.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-define-config": "^1.23.0",
        "eslint-plugin-jest": "^27.2.1",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.3.4",
        "husky": "^8.0.0",
        "jest": "^27.3.1",
        "less": "^4.2.0",
        "less-loader": "^11.1.3",
        "playwright": "^1.62.1",
        "postcss": "^8.4.31",
        "postcss-html": "^1.5.0",
        "postcss-scss": "^4.0.9",
        "prettier": "^2.7.1",
        "react-hooks": "^1.0.1",
        "sass": "^1.69.5",
        "sass-loader": "^13.3.2",
        "stylelint": "^15.11.0",
        "stylelint-config-prettier": "^9.0.5",
        "stylelint-config-recess-order": "^4.4.0",
        "stylelint-config-recommended-scss": "^13.1.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-config-standard-scss": "^11.1.0",
        "stylelint-config-standard-vue": "^1.0.0",
        "stylelint-order": "^6.0.3",
        "stylelint-scss": "^5.3.1",
        "terser": "^5.25.0",
        "vite": "^4.3.2",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-eslint": "^1.8.1"
    }
}
